<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="@color/holo_blue_dark" android:endColor="@color/holo_blue_light" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke android:width="1dp" android:color="@color/holo_blue_bright" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#ff3a3a3a" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke android:width="1dp" android:color="#ff555555" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#ff4a4a4a" android:endColor="#ff2c2c2c" />
            <corners android:radius="@dimen/corner_radius" />
            <stroke android:width="1dp" android:color="#ff666666" />
        </shape>
    </item>
</selector>
